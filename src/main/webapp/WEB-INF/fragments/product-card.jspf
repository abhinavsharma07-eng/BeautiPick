<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%--
  Reusable Product Card Fragment
  Expects either:
    - 'product' (direct Product instance)
    - 'rec' (RecommendationResult instance with .product and .matchReason)
    - or explicitly 'cardProduct' and optional 'cardReason'
--%>
<c:set var="cardItem" value="${not empty cardProduct ? cardProduct : (not empty rec.product ? rec.product : product)}" />
<c:set var="reasonText" value="${not empty cardReason ? cardReason : (not empty rec.matchReason ? rec.matchReason : '')}" />

<div class="product-card" data-category="<c:out value="${cardItem.category}"/>">
  <div class="card-image-wrap">
    <c:choose>
      <c:when test="${not empty cardItem.imageUrl and (cardItem.imageUrl.startsWith('http://') or cardItem.imageUrl.startsWith('https://'))}">
        <img src="<c:out value="${cardItem.imageUrl}"/>"
             alt="<c:out value="${cardItem.name}"/>"
             class="product-image"
             loading="lazy" />
      </c:when>
      <c:otherwise>
        <img src="${pageContext.request.contextPath}/<c:out value="${not empty cardItem.imageUrl ? cardItem.imageUrl : 'images/placeholder.svg'}"/>"
             alt="<c:out value="${cardItem.name}"/>"
             class="product-image"
             loading="lazy" />
      </c:otherwise>
    </c:choose>
    <span class="category-pill"><c:out value="${cardItem.category}"/></span>
  </div>

  <div class="card-body">
    <span class="product-brand"><c:out value="${cardItem.brand}"/></span>
    <h3 class="product-name">
      <a href="${pageContext.request.contextPath}/product?id=<c:out value="${cardItem.id}"/>">
        <c:out value="${cardItem.name}"/>
      </a>
    </h3>

    <c:if test="${not empty reasonText}">
      <div class="card-match-reason">
        <span class="match-badge-icon">&#10003;</span>
        <p class="match-text"><c:out value="${reasonText}"/></p>
      </div>
    </c:if>

    <div class="card-footer-pricing">
      <div class="price-block">
        <span class="price-label">Lowest Price</span>
        <span class="price-amount"><c:out value="${cardItem.formattedLowestPrice}"/></span>
      </div>
      <a href="${pageContext.request.contextPath}/product?id=<c:out value="${cardItem.id}"/>"
         class="btn btn-primary btn-card">
        Compare Prices &amp; Buy
      </a>
    </div>
  </div>
</div>
