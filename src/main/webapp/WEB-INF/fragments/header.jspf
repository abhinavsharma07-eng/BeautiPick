<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- item 13: determine active page from request URI --%>
<c:set var="reqURI" value="${pageContext.request.requestURI}" />
<header class="site-header">
  <div class="header-inner container">
    <div class="header-left">
      <a href="${pageContext.request.contextPath}/home" class="site-logo">
        <span class="logo-mark">&#10047;</span>
        <span class="logo-text">Beauti<strong>Pick</strong></span>
      </a>
      <%-- item 7: two labels for btn-quiz-header; short one shown at ≤360px --%>
      <a href="${pageContext.request.contextPath}/quiz" class="btn btn-secondary-outline btn-quiz-header" title="Take our personalized skincare quiz">
        <span class="icon-sparkle">&#10024;</span>
        <span class="btn-quiz-label-long"> Get Recommendations</span>
        <span class="btn-quiz-label-short">Quiz</span>
      </a>
    </div>

    <nav class="header-nav" aria-label="Site navigation">
      <ul class="nav-links">
        <li>
          <a href="${pageContext.request.contextPath}/home"
             class="nav-link${reqURI.endsWith('/home') or reqURI.endsWith('/index.jsp') ? ' nav-active' : ''}"
             ${reqURI.endsWith('/home') or reqURI.endsWith('/index.jsp') ? 'aria-current="page"' : ''}>Home</a>
        </li>
        <li>
          <a href="${pageContext.request.contextPath}/products"
             class="nav-link${reqURI.contains('/products') ? ' nav-active' : ''}"
             ${reqURI.contains('/products') ? 'aria-current="page"' : ''}>Browse &amp; Compare</a>
        </li>
        <%-- item 5: hide the duplicate "Skin Quiz" link on mobile via CSS class nav-link-skin-quiz;
             the "Get Recommendations" button in header-left already links to /quiz --%>
        <li>
          <a href="${pageContext.request.contextPath}/quiz"
             class="nav-link nav-link-skin-quiz${reqURI.contains('/quiz') ? ' nav-active' : ''}"
             ${reqURI.contains('/quiz') ? 'aria-current="page"' : ''}>Skin Quiz</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
